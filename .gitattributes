# LaneView line-ending & diff policy.
#
# The repository canonically stores text as LF. This is pinned here so it no
# longer depends on any machine's core.autocrlf / core.eol setting -- every
# clone, on every OS, normalizes the same way.

# Default: let git auto-detect text vs binary; store & check out text as LF.
* text=auto eol=lf

# --- Source & plain-text project files: always LF -------------------------
*.c   text eol=lf
*.h   text eol=lf
*.def text eol=lf
*.mak text eol=lf
*.vcw text eol=lf

# --- Binary assets: never apply text/eol conversion -----------------------
*.ico binary
*.slm binary
*.lgo binary
*.lib binary
*.doc binary
*.wsp binary
fonts/fontbold     binary
fonts/fontlght     binary
icons/fontbold     binary
icons/fontlght     binary

# UpgradeLog.htm is UTF-16 (auto-generated by the VS upgrade wizard); treat as
# binary so eol normalization cannot corrupt its byte-order mark / NUL bytes.
src/UpgradeLog.htm binary
